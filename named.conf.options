options {
    directory "/var/cache/bind";

    recursion yes;

    allow-query { any; };

    allow-recursion {
        localhost;
        192.168.123.0/24;
    };

    allow-query-cache {
        localhost;
        192.168.123.0/24;
    };

    allow-transfer { none; };

    forward only;
    forwarders { 192.168.123.5; };

    listen-on { any; };
    listen-on-v6 { none; };

    dnssec-validation auto;
};
